<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FF121412"
    android:padding="32dp">

    <TextView
        android:id="@+id/task_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Task"
        android:textColor="#FFC8E6C9"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/timer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="24:59"
        android:textColor="#FFE2E3DF"
        android:textSize="80sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="24dp" />

    <!-- Progress dots simulation -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="64dp">
        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/dot_active" android:layout_margin="4dp"/>
        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/dot_inactive" android:layout_margin="4dp"/>
        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/dot_inactive" android:layout_margin="4dp"/>
        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/dot_inactive" android:layout_margin="4dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_give_up"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Give Up"
        android:textColor="#FFB3261E"
        android:backgroundTint="#FF000000"
        style="?android:attr/borderlessButtonStyle"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

</LinearLayout>